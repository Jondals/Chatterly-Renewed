# Load with `node --env-file=.env dist/index.js` or export in your process manager. All values are optional for local dev.
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# REQUIRED in production — long random strings (e.g. `openssl rand -base64 48`).
JWT_SECRET=
SERVER_SECRET=

# Storage (defaults to ./data)
DATA_DIR=./data
# DB_PATH=./data/chatterly.db
# UPLOAD_DIR=./data/uploads

# GIF picker (GIPHY API key, free: https://developers.giphy.com/dashboard). GIF search is off when empty.
# The browser never talks to GIPHY: searches and downloads are proxied through this server.
GIPHY_API_KEY=

# Usernames (comma separated) that administer the beta program from Settings > Administration of the app.
ADMIN_USERS=Jondals

# WebRTC ICE servers
STUN_URLS=stun:stun.l.google.com:19302
# coturn with `use-auth-secret`; credentials are minted per user and expire after an hour
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=

# Terminate TLS here, or (recommended) in a reverse proxy and set TRUST_PROXY=1
# TLS_KEY=./certs/key.pem
# TLS_CERT=./certs/cert.pem
# TRUST_PROXY=1
