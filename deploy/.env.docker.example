# Copy to ../.env (next to docker-compose.yml) and fill it in.
# Your domain, already pointing to the public IP of the machine (a free one from duckdns.org works).
DOMAIN=chatterly.example.com
# Long random texts: openssl rand -base64 48. If left empty the server makes them and keeps them in the data volume.
JWT_SECRET=
SERVER_SECRET=
# Usernames (comma separated) that administer the beta program from Settings > Administration of the app.
ADMIN_USERS=Jondals
# Secret that the build uses to upload a beta installer (32 characters or more, e.g. openssl rand -base64 48). Empty = nobody can upload.
BETA_UPLOAD_TOKEN=
# Optional: GIF search (free key from developers.giphy.com).
GIPHY_API_KEY=
# Your own TURN relay for calls: `bash deploy/turn-setup.sh` fills these four by itself.
TURN_URLS=
TURN_SECRET=
TURN_PUBLIC_IP=
TURN_PRIVATE_IP=
# Or, instead of your own relay: Cloudflare's managed TURN (dash.cloudflare.com > Realtime > TURN Server > Create).
# Nothing runs or is opened on this machine, and the address of the server is never shown. Leave TURN_URLS/TURN_SECRET empty.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 1 = every call goes through your relay: nobody (nor a third party like Google) learns the address of anybody. `bash deploy/turn-setup.sh --private` sets it.
RELAY_ONLY=
# Seconds the relay credentials stay valid (300 to 604800, default 3600). Longer calls need nothing extra: the app renews them. A long value (86400) avoids any renewal during a very long call.
TURN_TTL_SEC=
