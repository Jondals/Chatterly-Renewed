# Caddyfile used by docker-compose.yml. The domain comes from the DOMAIN variable of the .env file.
{$DOMAIN} {
	encode zstd gzip

	# * Defensive headers: HTTPS only (HSTS), no type guessing, no referrer, no framing, camera/microphone only here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
	}

	# * No referrer and no framing for everything EXCEPT the page of the YouTube player (/api/player/*): the iPhone and iPad app frames it
	#   and the player inside needs to receive the address of that page as Referer, or YouTube refuses to play (error 153). The page
	#   sends its own Content-Security-Policy (frame-ancestors only for the app) and Referrer-Policy.
	@plain not path /api/player/*
	header @plain {
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}

	# ? Nothing bigger than the largest upload (12 MB of encrypted file) is passed on to the app.
	request_body {
		max_size 14MB
	}

	# ! Extra CSP for the web (it adds to the one in index.html: both apply and the stricter wins). index.html allows WebSockets to
	#   ANY server (wss:) and to localhost; this header allows them only to this domain, so a script injected by mistake
	#   could not send data anywhere else. The API sends its own CSP, so it is left out here.
	@web not path /api/* /ws
	header @web +Content-Security-Policy "connect-src 'self' wss://{$DOMAIN}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"

	# ! The API AND the WebSocket must go to the backend (3000), or sign-in fails with "JSON.parse: unexpected character".
	#   Everything else is the web app.
	@backend path /api/* /ws
	reverse_proxy @backend app:3000
	reverse_proxy app:4200
}
