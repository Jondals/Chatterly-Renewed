{
  "name": "chatterly-renewed-desktop",
  "version": "2.35.0",
  "productName": "Chatterly",
  "homepage": "https://github.com/Jondals/ChatterlyRenewed",
  "desktopName": "chatterly.desktop",
  "description": "Chatterly-Renewed desktop shell (Electron): the same end-to-end encrypted web app in a hardened window.",
  "main": "src/main.cjs",
  "private": true,
  "license": "ISC",
  "author": "Jondals",
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "node test/desktop.mjs",
    "web": "node scripts/copy-web.mjs",
    "dist": "node scripts/dist.mjs win",
    "dist:linux": "node scripts/dist.mjs linux",
    "dist:store": "node scripts/dist-store.mjs",
    "dist:mac": "node scripts/dist.mjs mac"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.chatterly.renewed",
    "productName": "Chatterly",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "syncDesktopName": true,
      "maintainer": "Jondals <noreply@github.com>",
      "artifactName": "Chatterly-${env.CHATTERLY_LABEL}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Chatterly-${env.CHATTERLY_LABEL}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Chatterly uses the camera only in the calls where you turn it on.",
        "NSMicrophoneUsageDescription": "Chatterly uses the microphone only in your calls.",
        "NSScreenCaptureUsageDescription": "Chatterly captures the screen only when you choose to share it in a call."
      }
    },
    "dmg": {
      "artifactName": "Chatterly-${env.CHATTERLY_LABEL}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Chatterly-${env.CHATTERLY_LABEL}.${ext}",
      "differentialPackage": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jondals",
        "repo": "ChatterlyRenewed",
        "releaseType": "release"
      }
    ],
    "appx": {
      "applicationId": "Chatterly",
      "displayName": "Chatterly",
      "languages": [
        "en-US",
        "es-ES"
      ],
      "showNameOnTiles": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
