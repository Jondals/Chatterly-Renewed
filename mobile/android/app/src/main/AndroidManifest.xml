<?xml version="1.0" encoding="utf-8"?>
<!--
  mobile/android/app/src/main/AndroidManifest.xml
  The Android app of Chatterly-Renewed: one screen with the web app packed inside the APK.
  ! Security choices (checked by mobile/test/mobile.mjs):
    - allowBackup="false" plus dataExtractionRules / fullBackupContent that exclude everything: keys, sessions and
      messages never go to a cloud backup or to a new phone (allowBackup alone does not stop device transfers on
      Android 12+).
    - No clear-text traffic, and only the certificates of the system are trusted (network_security_config.xml).
    - Only the main screen is exported (other apps may open it, nothing else). The FileProvider is not exported.
    - Permissions: only what a call needs. Camera and microphone are asked when a call uses them, never at start.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ! Keeps the microphone of a call alive with the screen off. Not exported; type "microphone" only, started by
             the page when a call connects and stopped when it ends (CallForegroundService.java). -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ! Captures the screen while it is shared in a call. Not exported; type "mediaProjection" only, started by the
             page after the person accepted the dialog of the system and stopped when sharing ends
             (ScreenForegroundService.java). -->
        <service
            android:name=".ScreenForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ! AndroidX adds this receiver EXPORTED (guarded by the DUMP permission) for performance tools; the app does not
             need it, so the merged manifest leaves it out and only the main screen stays exported. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calls: the microphone and the camera, asked by the WebView when a call starts them (runtime permissions). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calls: route the voice to the earpiece, the speaker or a headset. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Calls with the screen off: the foreground service of type microphone (only while a call is on). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Sharing the screen: the foreground service of type mediaProjection (only while the screen is shared). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Updates: hand a downloaded new version to the installer of Android (the person confirms; see UpdatePlugin.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A phone without a camera can still install the app (voice calls and chat). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
