<?xml version="1.0" encoding="utf-8"?>
<!--
  mobile/android/app/src/main/res/values/styles.xml
  The themes of the app: always dark, like the web app. The window background is the background of the page, so the strip
  behind the status bar and the navigation bar (the WebView is kept out of them) looks like part of the app.
-->
<resources>

    <!-- The background of the app (the same dark as the page: the ink 950 token and the boot cover of index.html). -->
    <color name="chatterly_background">#06070B</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/chatterly_background</item>
        <item name="colorPrimaryDark">@color/chatterly_background</item>
        <item name="colorAccent">#2EF2B0</item>
        <item name="android:windowBackground">@color/chatterly_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/chatterly_background</item>
    </style>

    <!-- The start screen: the logo on the dark background (Android 12+ draws it from these; older ones use splash.png). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/chatterly_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
